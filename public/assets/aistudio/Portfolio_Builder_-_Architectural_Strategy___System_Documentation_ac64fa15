4. Mongoose Database Schema Design
1. User Schema (User.js)
const userSchema = new mongoose.Schema({


  name: { type: String, required: true },


  email: { type: String, required: true, unique: true },


  passwordHash: { type: String, required: true },


  role: { type: String, enum: ['user', 'admin'], default: 'user' },


  createdAt: { type: Date, default: Date.now }


});
2. Theme Schema (Theme.js)
const themeSchema = new mongoose.Schema({


  title: { type: String, required: true },


  slug: { type: String, required: true, unique: true },


  description: { type: String },


  thumbnailUrl: { type: String, required: true },


  previewUrl: { type: String, required: true },


  price: { type: Number, required: true }, // 0 for free themes


  currency: { type: String, default: 'USD' },


  isActive: { type: Boolean, default: true },


  schemaDefinition: { type: Object, required: true } // Defines JSON structure for theme layout


}, { timestamps: true });
3. Purchase / Transaction Schema (Purchase.js)
const purchaseSchema = new mongoose.Schema({


  userId: { type: mongoose.Schema.Types.ObjectId, ref: 'User', required: true },


  themeId: { type: mongoose.Schema.Types.ObjectId, ref: 'Theme', required: true },


  transactionId: { type: String, required: true, unique: true },


  paymentProvider: { type: String, enum: ['stripe', 'sslcommerz', 'bkash'], required: true },


  amountPaid: { type: Number, required: true },


  currency: { type: String, required: true },


  status: { type: String, enum: ['pending', 'completed', 'failed'], default: 'pending' }


}, { timestamps: true });
4. Portfolio Document Schema (Portfolio.js)
const portfolioSchema = new mongoose.Schema({


  userId: { type: mongoose.Schema.Types.ObjectId, ref: 'User', required: true },


  themeId: { type: mongoose.Schema.Types.ObjectId, ref: 'Theme', required: true },


  title: { type: String, default: 'My Portfolio' },


  contentData: { type: Object, default: {} }, // User custom text, images, projects, links


  isPublished: { type: Boolean, default: false },


  customDomain: { type: String, unique: true, sparse: true }


}, { timestamps: true });


